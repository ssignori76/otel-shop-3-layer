# ==============================================================================
# OTel Shop 3-Layer — Environment Variables Template (.env.example)
# Copy to .env (never commit .env to Git) and customize for your mode:
#   Mode 1 (dev):       make up-dev
#   Mode 2 (prod):      make up-prod
#   Mode 3 (prod-otel): make up-prod-otel
# ==============================================================================

# Image registry & version (use lusig76/otel-shop- prefix in Production if pulling from Docker Hub)
IMAGE_REGISTRY=commerce
APP_VERSION=2.0.0

# Public host ports
APACHE_HOST_PORT=18080
JAEGER_UI_HOST_PORT=16686
VICTORIA_METRICS_HOST_PORT=18428
VICTORIA_LOGS_HOST_PORT=19428

# MySQL credentials (change in Production)
MYSQL_ROOT_PASSWORD=root_local_dev_only
MYSQL_AUTH_USER=auth_app
MYSQL_AUTH_PASSWORD=auth_local_dev_only
MYSQL_CART_USER=cart_app
MYSQL_CART_PASSWORD=cart_local_dev_only
MYSQL_CHECKOUT_USER=checkout_app
MYSQL_CHECKOUT_PASSWORD=checkout_local_dev_only
MYSQL_FULFILLMENT_USER=fulfillment_app
MYSQL_FULFILLMENT_PASSWORD=fulfillment_local_dev_only

# RabbitMQ credentials (change in Production)
RABBITMQ_USER=commerce_app
RABBITMQ_PASSWORD=rabbit_local_dev_only

# JWT & Demo Auth (change JWT_SECRET in Production — minimum 32 characters)
JWT_SECRET=commerce-local-dev-jwt-secret-key-2026-change-in-prod
JWT_EXPIRATION_SECONDS=86400
DEMO_USER_ENABLED=true
DEMO_USER_EMAIL=demo@otelshop.local
DEMO_USER_PASSWORD=DemoPass123!

# Journey Generator
GENERATOR_ENABLED=true
GENERATOR_INTERVAL_SECONDS=10
GENERATOR_INITIAL_DELAY_SECONDS=5
GENERATOR_MAX_IN_FLIGHT=1
GENERATOR_REQUEST_TIMEOUT_SECONDS=30
GENERATOR_MAX_JOURNEYS=0
GENERATOR_AUTH_ENABLED=true
GENERATOR_AUTH_EMAIL=synthetic@otelshop.local
GENERATOR_AUTH_PASSWORD=SynthPass123!
GENERATOR_STATIC_TOKEN=

# Fault Injection Scenarios (SCENARIO_ENABLED=false always forces NORMAL)
SCENARIO_NAME=NORMAL
SCENARIO_ENABLED=false
DB_SLOW_DURATION_MS=1500
DB_OPERATION_TIMEOUT_MS=1000
MERCHANT_TIMEOUT_MS=1500
BROKER_PUBLISH_TIMEOUT_MS=1500
FULFILLMENT_ERROR_AFTER_MS=100

# ==============================================================================
# Mode 3 ONLY (prod-otel): Official Dynatrace OpenTelemetry Collector
# ==============================================================================
# Dynatrace OTLP base URL:
#   SaaS:       https://<environment-id>.live.dynatrace.com/api/v2/otlp
#   ActiveGate: https://<activegate-host>:9999/e/<environment-id>/api/v2/otlp
DT_OTLP_ENDPOINT=https://<environment-id>.live.dynatrace.com/api/v2/otlp
DT_ENVIRONMENT=production

# Authentication scheme (choose ONE):
#   1. Classic API Token: DT_AUTH_SCHEME=Api-Token
#      Required scopes: openTelemetryTrace.ingest, metrics.ingest, logs.ingest
#   2. Platform Token:    DT_AUTH_SCHEME=Bearer
#      Required scopes: openpipeline:traces:ingest, openpipeline:metrics:ingest, openpipeline:logs:ingest
DT_AUTH_SCHEME=Api-Token
DT_API_TOKEN=
