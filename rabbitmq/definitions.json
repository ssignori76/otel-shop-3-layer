{
  "rabbit_version": "3.13.7",
  "users": [
    {
      "name": "commerce_app",
      "password": "rabbit_local_dev_only",
      "tags": ["administrator"]
    }
  ],
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "permissions": [
    {
      "user": "commerce_app",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "exchanges": [
    {
      "name": "commerce.orders",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "commerce.orders.dlx",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "commerce.fulfillment",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "commerce.orders.dlx",
        "x-dead-letter-routing-key": "order.created"
      }
    },
    {
      "name": "commerce.fulfillment.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "commerce.orders",
      "vhost": "/",
      "destination": "commerce.fulfillment",
      "destination_type": "queue",
      "routing_key": "order.created",
      "arguments": {}
    },
    {
      "source": "commerce.orders.dlx",
      "vhost": "/",
      "destination": "commerce.fulfillment.dlq",
      "destination_type": "queue",
      "routing_key": "order.created",
      "arguments": {}
    }
  ]
}
